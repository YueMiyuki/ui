{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "content/**",
      "*.ts",
      "*.mjs",
      "*.json",
      "!registry.json",
      "!public",
      "!src/registry/__generated__",
      "!next-env.d.ts",
      "!.next",
      "!.source",
      "!.shots",
      "!.codegraph"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "error",
        "noComponentHookFactories": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noThenProperty": "off",
        "noShadowRestrictedNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          },
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/miyuki-ui/caustics.tsx",
        "src/components/miyuki-ui/colour-split.tsx",
        "src/components/miyuki-ui/drifting-clouds.tsx",
        "src/components/miyuki-ui/frost-glass.tsx",
        "src/components/miyuki-ui/lake-freeze.tsx",
        "src/components/miyuki-ui/still-water.tsx",
        "src/components/miyuki-ui/two-tone-print.tsx",
        "src/components/miyuki-ui/voice-orb.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    }
  ]
}
